# Copy to .env and fill in. .env is gitignored — never commit it.

# Enphase Envoy (ADU solar) — Enlighten cloud login, used only to mint
# the local-API JWT. Leave blank to disable the collector.
ENPHASE_USERNAME=you@example.com
ENPHASE_PASSWORD=

# Optional overrides (defaults shown)
#ENVOY_HOST=10.10.0.222
#HOMEPOWER_HOST=0.0.0.0
#HOMEPOWER_PORT=8425
#DJANGO_DEBUG=false
