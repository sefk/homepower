# Copy to .env and fill in. .env is gitignored — never commit it.

# Enphase Envoy (ADU solar) — Enlighten cloud login, used only to mint
# the local-API JWT. Leave blank to disable the collector.
ENPHASE_USERNAME=you@example.com
ENPHASE_PASSWORD=

# Rainforest Eagle 3 (grid). From the label on the bottom of the unit.
# Used only to configure the device / query its local API — the Eagle
# pushes readings to /ingest/eagle/ on its own.
EAGLE_CLOUD_ID=
EAGLE_INSTALL_CODE=

# Optional overrides (defaults shown)
#EAGLE_HOST=10.10.0.216
#EAGLE_NOMINAL_INTERVAL_S=15
#ENVOY_HOST=10.10.0.222
#HOMEPOWER_HOST=0.0.0.0
#HOMEPOWER_PORT=8425
#DJANGO_DEBUG=false
