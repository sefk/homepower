# Copy to .env and fill in. .env is gitignored — never commit it.

# Enphase Envoy (ADU solar) — Enlighten cloud login, used only to mint
# the local-API JWT. Leave blank to disable the collector.
ENPHASE_USERNAME=you@example.com
ENPHASE_PASSWORD=

# Rainforest Eagle 3 (grid). From the label on the bottom of the unit.
# Used only to configure the device / query its local API — the Eagle
# pushes readings to /ingest/eagle/ on its own.
EAGLE_CLOUD_ID=
EAGLE_INSTALL_CODE=

# SolarEdge cloud (main array). The monitoring.solaredge.com portal login
# -- no API key needed. Site id is the number in the portal URL after
# signing in. Leave blank to disable the collector.
SOLAREDGE_USERNAME=
SOLAREDGE_PASSWORD=
SOLAREDGE_SITE_ID=

# Tesla Fleet API (EV). See ops/tesla-setup.md for app registration,
# public-key hosting, and running `manage.py tesla_auth` to get the
# refresh token. Leave TESLA_CLIENT_ID/TESLA_REFRESH_TOKEN blank to
# disable the collector.
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REFRESH_TOKEN=
#TESLA_VIN=              # optional; blank uses the account's first vehicle
#TESLA_REGION=na         # na | eu | cn

# Home coordinates, for the Tesla collector's best-effort home-charging
# geofence. Leave blank to count every charging reading as home.
#HOME_LAT=
#HOME_LON=

# Optional overrides (defaults shown)
#EAGLE_HOST=10.10.0.216
#EAGLE_NOMINAL_INTERVAL_S=15
#ENVOY_HOST=10.10.0.222
#HOMEPOWER_HOST=0.0.0.0
#HOMEPOWER_PORT=8425
#DJANGO_DEBUG=false
